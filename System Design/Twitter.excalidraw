    {
      "id": "6PMD6NWE9vaNSphhx6ncH",
      "type": "text",
      "x": -202.60269901045393,
      "y": 1653.2993559653294,
      "width": 484.81982421875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 1154322710,
      "version": 758,
      "versionNonce": 1337780374,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1739891179550,
      "link": null,
      "locked": false,
      "text": "1) Authentication & Authorization\n        - handled by Auth & IAM service\n        - ensures that every req comes \n            from legitimate user\n        -  user have permissions to \n            perform the reuested action\n2) Encrytion\n    - all data both in rest and transit \n        should be encrypt\n    - weuse HTTPS to encrypt data \n        that's in transit\n    - rest data is encrypted using modern DBs\n3) Rate Limiting\n    - ensures limited tweets and replies\n    - prevent DDOS attacks( do IP rate limiting\n                                    in our API gateway)\n\n4) Input Validation\n    - no cross site scripting \n    - other malicious attacks",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Authentication & Authorization\n        - handled by Auth & IAM service\n        - ensures that every req comes \n            from legitimate user\n        -  user have permissions to \n            perform the reuested action\n2) Encrytion\n    - all data both in rest and transit \n        should be encrypt\n    - weuse HTTPS to encrypt data \n        that's in transit\n    - rest data is encrypted using modern DBs\n3) Rate Limiting\n    - ensures limited tweets and replies\n    - prevent DDOS attacks( do IP rate limiting\n                                    in our API gateway)\n\n4) Input Validation\n    - no cross site scripting \n    - other malicious attacks",
      "autoResize": true,
      "lineHeight": 1.25
    },
